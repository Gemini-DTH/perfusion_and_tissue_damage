#!/bin/bash -l
#SBATCH -J fenics_simulation
#SBATCH -N 4
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem-per-cpu=32GB
#SBATCH --time=12:00:00
#SBATCH -A plggemini2026-cpu
#SBATCH -p plgrid
#SBATCH --output="/net/pr2/projects/plgrid/plgggemini/perfusion_and_tissue_damage/out_k.out"
#SBATCH --error="/net/pr2/projects/plgrid/plgggemini/perfusion_and_tissue_damage/err_k.err"

set -e
cd $SCRATCHDIR

{% stage_in_by_filename config.xml %}
{% stage_in_by_filename Clots.txt %}
{% stage_in_by_filename Model_parameters.txt %}

BASE_DIR="/net/pr2/projects/plgrid/plgggemini/perfusion_and_tissue_damage"
CONTAINER="$BASE_DIR/perfusion_and_tissue_damage.sif"
BLOODFLOW_DIR="$BASE_DIR/bloodflow/DataFiles/DefaultPatient"
SCRIPT_DIR="$BASE_DIR/bloodflow/Generated_Patients"    
PATIENT_DIR="patient_${SLURM_JOB_ID}"
ZIP_NAME="${PATIENT_DIR}.zip"
ZIP_PATH="${SCRATCHDIR}/${ZIP_NAME}"

echo "SLURM_JOB_ID=$SLURM_JOB_ID"
echo "PATIENT_DIR=$PATIENT_DIR"
echo "ZIP_NAME=$ZIP_NAME"
echo "ZIP_PATH=$ZIP_PATH"

singularity exec \
    --bind "$BASE_DIR:/mnt/project" \
	--bind "$SCRATCHDIR:/mnt/scratch" \
    --cleanenv \
    "$CONTAINER" \
    bash -c "
        export PATH=\$HOME/.local/bin:\$PATH
        export PYTHONPATH=\$HOME/.local/lib/python3.*/site-packages:\$PYTHONPATH
        export PYTHONPATH=/mnt/project/bloodflow/Blood_Flow_1D:$PYTHONPATH
        
	python3 -m pip install --user --no-cache-dir networkx
	python3 -m pip install --user --no-cache-dir vtk
	python3 -m pip install --user --no-cache-dir mgmetis==0.1.1
	python3 -m pip install --user --no-cache-dir pandas
	python3 -m pip install --user --no-cache-dir numpy==1.24.4
        
        cd /mnt/project/
		cp -TR ./bloodflow/DataFiles/DefaultPatient_old "./bloodflow/Generated_Patients/$PATIENT_DIR/"
		#sed -i '26 c CollateralPatientGen=True' './Generated_Patients/$PATIENT_DIR/bf_sim/Model_parameters.txt'
		cp -f /mnt/scratch/config.xml ./bloodflow/Generated_Patients/$PATIENT_DIR/config.xml
		cp -f /mnt/scratch/Clots.txt ./bloodflow/Generated_Patients/$PATIENT_DIR/Clots.txt
		cp -f /mnt/scratch/Model_parameters.txt ./bloodflow/Generated_Patients/$PATIENT_DIR/bf_sim/Model_parameters.txt
		cd bloodflow
		python3 generate_files.py "./Generated_Patients/$PATIENT_DIR/"
		#python3 ./Blood_Flow_1D/CollateralsSimulation.py "./Generated_Patients/$PATIENT_DIR/" 
		#python3 ./Blood_Flow_1D/ContrastModel.py "./Generated_Patients/$PATIENT_DIR/" True 50

    "


cd "$BASE_DIR/bloodflow/Generated_Patients" || exit 1
zip -r "$ZIP_PATH" "$PATIENT_DIR" || exit 1

if [ -f "$ZIP_PATH" ]; then
    echo "Zip file created: $ZIP_PATH"
else
    echo "Zip file not created!"
    exit 1
fi

du -sh "$ZIP_PATH"
ls -lh "$ZIP_PATH"

cp "$ZIP_PATH" "$SCRATCHDIR/patient_output.zip" || exit 1#ls -lh "$SCRATCHDIR/patient_output.zip"
cd "$SCRATCHDIR" || exit 1
{% stage_out patient_output.zip %}

